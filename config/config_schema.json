{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["qbit"],
  "properties": {
    "qbit": {
      "type": "object",
      "required": ["url", "username", "password"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://.*$" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "dry_run": { "type": "boolean" },
        "enable_auto_management": { "type": "boolean" },
        "auto_management_ignore_tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "quiet": { "type": "boolean" },
        "share_limits_tag": { "type": "string" },
        "tracker_error_tag": { "type": "string" },
        "share_limits_min_seeding_time_tag": { "type": "string" },
        "share_limits_min_num_seeds_tag": { "type": "string" },
        "share_limits_filter_completed": { "type": "boolean" }
      }
    },
    "processes": {
      "type": "object",
      "properties": {
        "tag_names": { "type": "boolean" },
        "cat_move": { "type": "boolean" },
        "tracker_tags": { "type": "boolean" },
        "tracker_errors": { "type": "boolean" },
        "share_limits": { "type": "boolean" }
      }
    },
    "trackers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["tags"],
        "properties": {
          "tags": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            ]
          }
        }
      }
    },
    "share_limits": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["priority"],
        "properties": {
          "priority": { "type": "integer" },
          "cleanup": { "type": "boolean" },
          "max_ratio": { "type": "number" },
          "max_seeding_time": { "$ref": "#/definitions/duration" },
          "min_seeding_time": { "$ref": "#/definitions/duration" },
          "min_num_seeds": { "type": "integer" },
          "limit_upload_speed": { "type": "integer" },
          "resume_torrent_after_change": { "type": "boolean" },
          "categories": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "include_all_tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "include_any_tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "exclude_all_tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "exclude_any_tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "names": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["tags"],
        "properties": {
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "cat_moves": {
      "$ref": "#/definitions/cat_moves"
    },
    "cat_move": {
      "$ref": "#/definitions/cat_moves"
    }
  },
  "definitions": {
    "duration": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string", "pattern": "^-?[0-9]+$|^([0-9]+[mhdw])+$" }
      ]
    },
    "cat_moves": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["new_category"],
        "anyOf": [{ "required": ["categories"] }, { "required": ["tags"] }],
        "properties": {
          "categories": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "new_category": { "type": "string" }
        }
      }
    }
  }
}
